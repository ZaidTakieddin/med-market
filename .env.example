# ─────────────────────────────────────────────────────────────────────────────
# Med Market — environment reference. Each variable notes its LOCAL value vs. the
# production SERVER value (Render). Copy to .env and fill in real secrets; never
# commit .env. The test suite uses its own values from phpunit.xml (sqlite, array
# cache, sync queue), so tests need nothing here.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="Med Market"                  # both: app name
APP_ENV=local                          # local: local | server: production
APP_KEY=                               # both: generate once with `php artisan key:generate`
APP_DEBUG=true                         # local: true | server: false
APP_URL=http://localhost               # local: http://localhost (or your Herd URL) | server: https://<your-app>.onrender.com

APP_LOCALE=en                          # both: en
APP_FALLBACK_LOCALE=en                 # both: en
APP_FAKER_LOCALE=en_US                 # both: en_US (seed/faker data)

APP_MAINTENANCE_DRIVER=file            # both: file
# APP_MAINTENANCE_STORE=database        # only if APP_MAINTENANCE_DRIVER=cache

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12                       # both: 12 (tests use 4 via phpunit.xml)

LOG_CHANNEL=stack                      # local: stack | server: stack (or stderr on Render)
LOG_STACK=single                      # both: single
LOG_DEPRECATIONS_CHANNEL=null          # both: null
LOG_LEVEL=debug                        # local: debug | server: error (or warning)

# ── Database: PostgreSQL on Neon ─────────────────────────────────────────────
# Web requests use Neon's POOLED endpoint (host has a `-pooler` suffix).
# Migrations/seeders and queue workers use Neon's DIRECT (unpooled) endpoint —
# the pooled endpoint aborts DDL/transactions. Local dev points at the same DB.
DB_CONNECTION=pgsql                    # local & server: pgsql (tests auto-use sqlite)
DB_HOST=<your-neon-pooler-host>.neon.tech   # local & server: Neon POOLED host (has -pooler)
DB_PORT=5432                          # both: 5432
DB_DATABASE=neondb                     # both: your Neon database name
DB_USERNAME=neondb_owner               # both: your Neon role
DB_PASSWORD=                           # both: your Neon password (SECRET)
DB_SSLMODE=require                     # both: require (Neon requires SSL)

# Unpooled endpoint for `migrate --database=pgsql_seeder` and db:seed.
DB_SEEDER_HOST=<your-neon-direct-host>.neon.tech   # local & server: Neon DIRECT host (no -pooler)
DB_SEEDER_PORT=5432                   # both: 5432
DB_SEEDER_DATABASE=neondb              # both: same database
DB_SEEDER_USERNAME=neondb_owner        # both: your Neon role
DB_SEEDER_PASSWORD=                    # both: your Neon password (SECRET)

SESSION_DRIVER=database                # both: database
SESSION_LIFETIME=120                   # both: 120 (minutes)
SESSION_ENCRYPT=false                  # both: false
SESSION_PATH=/                         # both: /
SESSION_DOMAIN=null                    # local: null | server: your domain (optional)

# ── API auth / CORS ──────────────────────────────────────────────────────────
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200 # both: 43200 (30 days; 0 = never expire)
CORS_ALLOWED_ORIGINS=*                 # local: * | server: your client origin(s), comma-separated
CORS_SUPPORTS_CREDENTIALS=false        # both: false

BROADCAST_CONNECTION=log               # both: log (no realtime broadcasting yet)
FILESYSTEM_DISK=local                  # both: local (framework default; media uses MEDIA_DISK below)

# ── Queue: database driver on Neon's unpooled connection ─────────────────────
QUEUE_CONNECTION=database              # both: database (Redis-ready)
DB_QUEUE_CONNECTION=pgsql_queue        # both: pgsql_queue (workers use the unpooled connection)
DB_QUEUE_HOST=<your-neon-direct-host>.neon.tech   # local & server: Neon DIRECT host (no -pooler)
DB_QUEUE_PORT=5432                     # both: 5432
DB_QUEUE_DATABASE=neondb               # both: same database
DB_QUEUE_USERNAME=neondb_owner         # both: your Neon role
DB_QUEUE_PASSWORD=                     # both: your Neon password (SECRET)
DB_QUEUE_TABLE=jobs                    # both: jobs
DB_QUEUE=default                       # both: default
DB_QUEUE_RETRY_AFTER=90                # both: 90 (seconds; must exceed each job's $timeout)
ENABLE_QUEUE_WORKER=true               # local: true (worker runs in-container) | server: false (use a separate Render worker)
# RUN_MIGRATIONS=true                   # local: off | server: optional auto-migrate on boot (off = run manually)

CACHE_STORE=database                   # local: file or database | server: file (Redis-ready)
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1               # both: 127.0.0.1 (unused)

REDIS_CLIENT=phpredis                  # both: phpredis (only if you switch to Redis)
REDIS_HOST=127.0.0.1                   # local: 127.0.0.1 | server: your Redis host (if used)
REDIS_PASSWORD=null                    # local: null | server: your Redis password (if used)
REDIS_PORT=6379                        # both: 6379

MAIL_MAILER=log                        # local: log (writes to log file) | server: smtp (real provider)
MAIL_SCHEME=null                       # local: null | server: tls (provider-dependent)
MAIL_HOST=127.0.0.1                    # local: 127.0.0.1 | server: your SMTP host
MAIL_PORT=2525                         # local: 2525 | server: provider port (e.g. 587)
MAIL_USERNAME=null                     # local: null | server: SMTP username
MAIL_PASSWORD=null                     # local: null | server: SMTP password (SECRET)
MAIL_FROM_ADDRESS="hello@example.com"  # both: your from-address
MAIL_FROM_NAME="${APP_NAME}"           # both: app name

# ── AWS / S3 (optional alternative media backend, e.g. Cloudflare R2) ─────────
AWS_ACCESS_KEY_ID=                     # both: only if MEDIA_DISK=s3 (else leave blank)
AWS_SECRET_ACCESS_KEY=                 # both: only if MEDIA_DISK=s3 (SECRET)
AWS_DEFAULT_REGION=us-east-1           # both: bucket region (R2: "auto")
AWS_BUCKET=                            # both: bucket name (if used)
AWS_USE_PATH_STYLE_ENDPOINT=false      # both: false (true for R2/MinIO)

# ── Media storage (product images, company logos) ────────────────────────────
# Binaries NEVER go in the DB — only {disk, path, url}. MEDIA_DISK picks the backend.
MEDIA_DISK=cloudinary                  # local: public (no creds; files in storage/) OR cloudinary | server: cloudinary
# Cloudinary dashboard → cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=                        # both: required when MEDIA_DISK=cloudinary (SECRET)

VITE_APP_NAME="${APP_NAME}"            # both: app name (used by the frontend build)
